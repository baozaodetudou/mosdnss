%%{init: {
      "flowchart": {
        "useMaxWidth": true,
        "htmlLabels": true,
        "curve": "basis",
        "rankSpacing": 60,
        "nodeSpacing": 40,
        "padding": 20
      },
      "themeVariables": {
        "fontSize": "32px",
        "fontFamily": "'LXGW WenKai', 'Inter', sans-serif",
        "primaryColor": "#EEF2FF",
        "edgeLabelBackground": "#FFFFFF",
        "clusterBkg": "#FAFAFA",
        "clusterBorder": "#E5E7EB"
      }
}}%%

flowchart LR
    %% --- 样式定义 ---
    classDef base fill:#EEF2FF,stroke:#4F46E5,stroke-width:2px,color:#1E1B4B;
    classDef decision fill:#ffffff,stroke:#4F46E5,stroke-width:2px,color:#1E1B4B,shape:diamond;
    classDef block fill:#FEF2F2,stroke:#DC2626,stroke-width:2px,color:#991B1B;
    classDef cn fill:#F0FDF4,stroke:#16A34A,stroke-width:2px,color:#14532D;
    classDef proxy fill:#F5F3FF,stroke:#7C3AED,stroke-width:2px,color:#4C1D95;
    classDef effect stroke-dasharray: 5 5,fill:#FFFBEB,stroke:#D97706,color:#92400E;

    %% --- 1. 入口与安全过滤 (Entry) ---
    subgraph SG_Entry ["1. 入口过滤与预处理"]
        direction TB
        %% 修复点：给文字加上双引号，并确保换行
        Start(["DNS 请求"]):::base --> SW_Type{类型检查}:::decision

        SW_Type -- "AAAA/SOA/HTTPS" --> Block_Type(["拦截/拒绝"]):::block
        SW_Type -- "正常查询" --> SW_DDNS{DDNS?}:::decision

        SW_DDNS -- "是" --> Ret_DDNS(["国内直连"]):::cn
        SW_DDNS -- "否" --> SW_Sec{安全检查<br/>黑名单/无V4V6/AdG}:::decision

        SW_Sec -- "命中拦截" --> Block_Sec(["拦截/屏蔽"]):::block
        SW_Sec -- "通过" --> SW_Client{客户端权限}:::decision

        SW_Client -- "未授权" --> Ret_Limit(["限制国内查询"]):::cn
        SW_Client -- "授权" --> Gate_Shunt((进入分流)):::base
    end

    %% --- 2. 核心分流 (Routing) ---
    subgraph SG_Route ["2. 名单与规则分流"]
        direction TB
        Gate_Shunt --> SW_Rewrite{重写/Geosite?}:::decision

        SW_Rewrite -- "Rewrite/GeositeCN" --> Ret_Direct(["国内/上游直连"]):::cn
        SW_Rewrite -- "常规流量" --> SW_List{名单匹配}:::decision

        SW_List -- "灰名单" --> Proxy_Grey(["FakeIP (Grey)"]):::proxy
        SW_List -- "白名单" --> Act_White[白名单国内查询]:::cn
        SW_List -- "黑/国外名单" --> Proxy_Foreign(["FakeIP (Foreign)"]):::proxy
        SW_List -- "未命中名单" --> Mode_Gate((进入模式决策)):::base
    end

    %% --- 3. 核心解析逻辑 (Resolution) ---
    subgraph SG_Resolution ["3. 智能解析模式"]
        direction TB

        %% 左侧：白名单处理
        Act_White --> Auto_White[补写无Vx记录]:::effect
        Auto_White --> Chk_Mihomo1{CN转Mihomo?}:::decision
        Chk_Mihomo1 -- "是" --> Ret_Fake_CN(["FakeIP (Mihomo)"]):::proxy
        Chk_Mihomo1 -- "否" --> Ret_Real_CN(["Real IP"]):::cn

        %% 核心：双模式并行
        Mode_Gate --> SW_Mode{模式选择}:::decision

        %% 上半部分：兼容模式
        subgraph Mode_Compat ["兼容模式 (国内优先)"]
            direction LR
            SW_Mode -- "兼容" --> Q_Compat[国内查询]:::cn
            Q_Compat --> Res_Compat{结果分析}:::decision

            Res_Compat -- "IP属中国" --> Chk_Mi2{CN转Mi?}:::decision
            Res_Compat -- "无结果/污染" --> Retry_Intl[国外补查]:::proxy

            Retry_Intl --> Upd_Foreign[+加自生成国外]:::effect
            Upd_Foreign --> Res_Intl_Final[国外结果]:::proxy

            Chk_Mi2 -- "是" --> Out_Fake_C(["FakeIP"]):::proxy
            Chk_Mi2 -- "否" --> Out_Real_C(["Real IP"]):::cn
        end

        %% 下半部分：安全模式
        subgraph Mode_Secure ["安全模式 (国外优先)"]
            direction LR
            SW_Mode -- "安全" --> Q_Secure[国外查询]:::proxy
            Q_Secure --> Res_Secure{结果分析}:::decision

            Res_Secure -- "IP非中国" --> Out_Fake_S(["FakeIP"]):::proxy
            Res_Secure -- "IP属中国/无结果" --> Retry_CN[国内补查]:::cn

            Retry_CN --> Upd_CN[+加自生成国内]:::effect
            Upd_CN --> Res_CN_Final[国内结果]:::cn
        end
    end

    %% --- 4. 终态汇聚 (Output) ---

    Ret_DDNS & Ret_Limit & Ret_Direct & Ret_Real_CN & Out_Real_C & Res_CN_Final --> End_Real((返回 Real IP)):::cn
    Proxy_Grey & Proxy_Foreign & Ret_Fake_CN & Out_Fake_C & Out_Fake_S & Res_Intl_Final --> End_Fake((返回 Fake IP)):::proxy
    Block_Type & Block_Sec --> End_Block((终止/NXDOMAIN)):::block

    %% 调整层级关系
    SG_Entry --> SG_Route --> SG_Resolution

    linkStyle default stroke:#6366f1,stroke-width:2px,fill:none;